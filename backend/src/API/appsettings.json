{
  "Application": {
    "Name": "NhuNguyetSpa.API",
    "Version": "0.1.0",
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "NhuNguyetSpa.API"
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
