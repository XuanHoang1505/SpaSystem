{
  "Application": {
    "Name": "NhuNguyetSpa.API",
    "Version": "0.1.0",
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NhuNguyetSpa.API",
    "Audience": "NhuNguyetSpa.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Account": {
    "OtpExpirationMinutes": 5,
    "OtpMaxFailedAttempts": 5,
    "OtpResendCooldownSeconds": 60,
    "PasswordResetTokenExpirationMinutes": 10,
    "PasswordMinLength": 8
  },
  "MailSettings": {
    "DisplayName": "Spa Như Nguyệt",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "TimeoutSeconds": 30
  },
  "Cloudinary": {
    "Folder": "nhunguyetspa",
    "TimeoutSeconds": 30
  },
  "ImageUpload": {
    "MaxBytes": 5242880
  },
  "Staff": {
    "TemporaryPasswordLength": 12
  },
  "WorkSchedule": {
    "MaxDaysAhead": 60,
    "MaxQueryRangeDays": 42,
    "MaxBatchShifts": 500
  },
  "Booking": {
    "SlotStepMinutes": 30,
    "MaxDaysAhead": 60,
    "MaxQueryRangeDays": 42,
    "NoShowConsumesEntitlement": false,
    "AutoAssignStrategy": "least_busy",
    "ReleaseHoldOnPaymentFailure": false
  },
  "Purchases": {
    "MaxListItems": 200
  },
  "Cart": {
    "MaxItems": 20
  },
  "Order": {
    "PaymentTimeoutMinutes": 15
  },
  "Payment": {
    "MaxAttemptsPerOrder": 5
  },
  "Vnpay": {
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "MinAmount": 5000,
    "ProcessReturnUrl": false
  },
  "OrderExpiry": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "GraceMinutes": 5,
    "BatchSize": 200
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "NhuNguyetSpa.API"
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
