# Copy this file to .env (same folder) and fill in real values. .env is git-ignored.
# Loaded by API/Configuration/EnvLoader.cs and by DesignTimeDbContextFactory (dotnet ef).
# Real environment variables with the same name override values in this file.

# =============================================================
# DATABASE (PostgreSQL) — local: `npm run db:up` starts it in Docker
# =============================================================
CONNECTION_STRING=Host=localhost;Port=5432;Database=nhunguyetspa;Username=spa;Password=spa_dev_password

# =============================================================
# API
# =============================================================
# SWAGGER_ENABLED=true

# =============================================================
# JWT (UC-SPA-02) — JWT_* maps to Jwt:* (defaults for the commented ones are in appsettings.json)
# =============================================================
# Required for login. Generate one, e.g. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=
# JWT_ISSUER=NhuNguyetSpa.API
# JWT_AUDIENCE=NhuNguyetSpa.Clients
# JWT_ACCESS_TOKEN_EXPIRATION=15
# JWT_REFRESH_TOKEN_EXPIRATION=7

# =============================================================
# MAIL (OTP, UC-SPA-01/03) — MAIL_SETTINGS_* maps to MailSettings:*
# =============================================================
# Real mail through Gmail SMTP. MAIL and PASSWORD are required to send OTPs; without them the API still
# starts and only the OTP endpoints return 503 email_send_failed.
# PASSWORD is a Gmail App Password, not the account password:
#   1. Turn on 2-Step Verification for the sending Gmail account.
#   2. Open https://myaccount.google.com/apppasswords, create one (e.g. "Spa Nhu Nguyet"), copy the 16 characters.
# Never commit or share it.
MAIL_SETTINGS_MAIL=
MAIL_SETTINGS_DISPLAY_NAME="Spa Như Nguyệt"
MAIL_SETTINGS_PASSWORD=
MAIL_SETTINGS_HOST=smtp.gmail.com
MAIL_SETTINGS_PORT=587

# =============================================================
# IMAGES (UC-SPA-09) — CLOUDINARY_* maps to Cloudinary:* (Folder, TimeoutSeconds in appsettings.json)
# =============================================================
# Service and package images are stored on Cloudinary. Without these three values the API still starts and only
# the image endpoints return 503 image_storage_unavailable.
# Where to find them: sign in at https://console.cloudinary.com → the Dashboard shows "Cloud name";
# Settings (gear icon) → API Keys lists the API key and its API secret (click to reveal).
# API_SECRET is a secret: keep it only here, never commit or share it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================
# ONLINE PAYMENT (UC-SPA-11) — VNPAY_* maps to Vnpay:*, PAYMENT_* to Payment:* (other values in appsettings.json)
# =============================================================
# VNPay sandbox: register at https://sandbox.vnpayment.vn/devreg — VNPay mails vnp_TmnCode and vnp_HashSecret.
# Without them the API still starts; only POST /me/orders/{id}/payments returns 503 payment_gateway_unavailable.
# HASH_SECRET is a secret: keep it only here, never commit, share or log it.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Public base URL of this API: VNPay sends the browser back to {base}/api/v1/payments/vnpay/return/{web|mobile}.
# The IPN URL registered on the VNPay merchant portal is {base}/api/v1/payments/vnpay/ipn (needs a public address,
# for example a tunnel); in Development the verified return URL records the result, so a tunnel is optional.
PAYMENT_PUBLIC_API_BASE_URL=https://localhost:7001
# Client result pages; the API redirects there with ?orderId=
PAYMENT_WEB_RETURN_URL=http://localhost:5173/payment/result
PAYMENT_MOBILE_RETURN_URL=

# =============================================================
# DEV SEED (npm run db:seed) — SEED_* maps to Seed:* — Development only
# =============================================================
# Creates the spa owner account if the email does not exist yet. Password: at least 8 characters.
SEED_OWNER_EMAIL=owner@nhunguyetspa.local
SEED_OWNER_PHONE=0900000000
SEED_OWNER_PASSWORD=
# SEED_OWNER_FULL_NAME="Chủ spa"
